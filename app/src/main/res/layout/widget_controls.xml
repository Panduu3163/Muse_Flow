<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_controls"
    android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center">
    <ImageButton android:id="@+id/widget_previous" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_widget_previous"
        android:contentDescription="@string/control_previous" />
    <ImageButton android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp"
        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:background="@drawable/widget_play_background" android:src="@drawable/ic_widget_play"
        android:contentDescription="@string/control_play" />
    <ImageButton android:id="@+id/widget_next" android:layout_width="48dp" android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_widget_next"
        android:contentDescription="@string/control_next" />
</LinearLayout>
